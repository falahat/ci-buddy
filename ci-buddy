set -euo pipefail
if [[ ${1:-} != --server ]]; then
    [[ -n ${BASH_SOURCE[0]:-} ]] || { echo 'replace the downloaded shim; use the installed local ci-buddy client' >&2; exit 2; }
    client_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    if [[ -f $client_dir/revision ]]; then revision=$(<"$client_dir/revision")
    else revision=$(git -C "$client_dir" rev-parse --verify HEAD); fi
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || exit 2
    cd "$(git rev-parse --show-toplevel)"
    while IFS= read -r line; do
        if [[ $line =~ ^(name|host|main)[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
            printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
        fi
    done <ci-buddy.toml
    : "${name:?}" "${host:?}" "${main:?}"
    [[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
    git check-ref-format "refs/heads/$main"
    # Endpoints belong to owner configuration, never executable project input.
    mapfile -t configured < <(git config --global --get-all ci-buddy.host || true)
    ((${#configured[@]})) || { echo 'install a trusted client with bash install-client.sh --host <destination>[:<root>]' >&2; exit 2; }
    transport=(python3 "$client_dir/ssh.py")
    endpoint_parts() {
        destination=${1%%:*}; remote_root=.ci-buddy
        [[ $1 != *:* ]] || remote_root=${1#*:}
        [[ $destination =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$ ]] || return 2
        [[ $remote_root == .ci-buddy || $remote_root == /* ]] || return 2
        [[ $remote_root != *$'\n'* && $remote_root != *$'\r'* ]] || return 2
        [[ $destination != local || $remote_root != .ci-buddy ]] || remote_root=$HOME/.ci-buddy
    }
    invoke() {
        local endpoint=$1; shift
        endpoint_parts "$endpoint" || return
        if [[ $destination == local ]]; then bash "$remote_root/bin/ci-buddy" --server "$name" "$@"
        else "${transport[@]}" "$destination" "bash $(printf '%q' "$remote_root/bin/ci-buddy") --server $(printf '%q ' "$name" "$@")"; fi
    }
    available=()
    # Probe every configured coordinator once; connection deadlines never kill jobs.
    preferred=(); others=()
    for endpoint in "${configured[@]}"; do
        if [[ $endpoint == "$host" || $endpoint == "$host:.ci-buddy" ]]; then preferred+=("$endpoint")
        else others+=("$endpoint"); fi
    done
    for endpoint in "${preferred[@]}" "${others[@]}"; do
        if value=$(invoke "$endpoint" version 2>&1 | head -c 42) && [[ $value == "$revision" ]]; then
            available+=("$endpoint")
        else printf 'host unavailable or version differs: %s\n' "$endpoint" >&2; fi
    done
    ((${#available[@]})) || { echo 'no configured host available; no job submitted' >&2; exit 2; }
    selected=${available[0]}
    remote() {
        invoke "$selected" "$@" 2>&1 | python3 "$client_dir/safe_output.py"
        local statuses=("${PIPESTATUS[@]}")
        ((statuses[1] == 0)) || return "${statuses[1]}"
        return "${statuses[0]}"
    }
    command=${1:?command required}; shift
    case $command in
        status|history)
            arguments=("$@")
            if [[ $command == history && ${1:-} == change ]]; then
                arguments=(change "$(git rev-parse "${2:?ref required}")" "$(git rev-parse "$2^{tree}")")
            elif [[ $command == history && ${1:-} == failures && ${2:-} == --range ]]; then
                range=${3:?range required}; arguments=(failures --range "$(git rev-parse "${range%..*}")..$(git rev-parse "${range#*..}")")
            fi
            result=0
            for selected in "${available[@]}"; do
                printf 'host=%s\n' "$selected"
                remote "$command" "${arguments[@]}" || result=$?
            done
            exit "$result" ;;
        log|cancel)
            run=${1:?run required}; [[ $run =~ ^[0-9]+$ ]] || exit 2
            found=false
            for selected in "${available[@]}"; do if value=$(invoke "$selected" has-run "$run" 2>&1 | head -c 42); then found=true; break; fi; done
            $found || { echo 'run not found on available hosts' >&2; exit 1; }
            remote "$command" "$run"; exit $? ;;
        verify|merge)
            candidate=$(git rev-parse "${1:-HEAD}")
            found=false
            for selected in "${available[@]}"; do if value=$(invoke "$selected" has-gate "$candidate" 2>&1 | head -c 42); then found=true; break; fi; done
            $found || { echo 'gate not found on available hosts' >&2; exit 1; }
            if [[ $command == verify ]]; then remote verify "$candidate"; exit $?; fi
            git diff --quiet HEAD -- || { echo 'commit tracked edits before merge' >&2; exit 1; }
            candidate=$(git rev-parse HEAD)
            result=$(remote verify "$candidate") || { printf '%s\n' "$result"; exit 1; }
            printf '%s\n' "$result"
            verified=${result##*$'\n'}
            [[ $verified =~ ^verified=$candidate\ base=([0-9a-f]+)$ ]] || exit 1
            expected=${BASH_REMATCH[1]}
            current=$(git ls-remote origin "refs/heads/$main")
            [[ $current == "$expected"$'\t'* ]] || { echo 'main moved; integrate it and gate again' >&2; exit 1; }
            git push origin "$candidate:refs/heads/$main"
            exit $? ;;
        run|test|gate) ;;
        *) echo 'expected run, test, gate, verify, merge, status, log or cancel' >&2; exit 2 ;;
    esac
    if [[ $command == test ]]; then
        arguments=("$@")
        for ((i=0; i<${#arguments[@]}; i++)); do
            if [[ ${arguments[i]} == --since ]]; then
                i=$((i+1)); arguments[i]=$(git rev-parse "${arguments[i]:?base required}")
            fi
        done
        set -- "${arguments[@]}"
    fi
    candidate=$(git rev-parse HEAD)
    changed=0
    git diff --quiet HEAD -- || changed=$?
    case $changed in
        0) ;;
        1) candidate=$(git stash create); [[ -n $candidate ]] || exit 1 ;;
        *) exit "$changed" ;;
    esac
    main_ref=$(git rev-parse --quiet --verify "origin/$main" || git rev-parse --verify "$main")
    base=$(git merge-base "$candidate" "$main_ref")
    branch=$(git symbolic-ref --quiet --short HEAD) || { status=$?; [[ $status == 1 ]] || exit "$status"; branch=""; }
    run=$((${EPOCHREALTIME/./} * 1000 + RANDOM % 1000))
    remote init
    endpoint_parts "$selected"
    target=$remote_root/projects/$name/git
    [[ $destination == local ]] || target=$destination:$target
    GIT_SSH_COMMAND=$(printf '%q ' "${transport[@]}") GIT_SSH_VARIANT=simple git push --quiet --no-verify "$target" "$candidate:refs/ci-buddy/$run" 2>&1 | python3 "$client_dir/safe_output.py"
    printf 'host=%s\n' "$selected"
    # After submit begins, a lost connection is ambiguous: never fail over/retry.
    if remote submit "$run" "$command" "$candidate" "$base" "$branch" "${CI_BUDDY_SUBMITTER:-$HOSTNAME}" "$@"; then exit 0
    else status=$?; printf 'submission ended with status %s; inspect run %s on %s before submitting again\n' "$status" "$run" "$selected" >&2; exit "$status"; fi
fi
shift
project=${1:?project required}; command=${2:?command required}; shift 2
[[ $project =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
root=$(cd "$(dirname "$0")/.." && pwd -P)
export PATH="$root/bin:$PATH"
export PUEUE_CONFIG_PATH="$root/pueue.yml"
data=$root/bin/data.py
folder=$root/projects/$project
field() { python3 "$data" field "$folder/runs/$run/$1"; }
write_field() { python3 "$data" write "$folder/runs/$run/$1" "$2"; }
wait_task() {
    local id=$1 prefix=${2:-} value
    value=$(field "${prefix}exit")
    [[ -z $value ]] || return 0
    pueue wait --quiet "$id" || true
    (
        flock 3
        value=$(field "${prefix}exit")
        if [[ -z $value ]]; then
            podman wait "ci-buddy-$run" || podman wait "ci-buddy-prepare-$run" || podman wait "ci-buddy-fetch-$run" || true
            python3 "$data" stamp "$folder/runs/$run" "${prefix//-/_}ended_at" "$EPOCHREALTIME"
            python3 "$data" report "$folder/runs/$run" "$prefix"
            write_field "${prefix}exit" 137
            python3 "$data" record "$folder/runs/$run"
            python3 "$root/bin/archive.py" "$folder/runs/$run"
            git -C "$folder/git" update-ref -d "refs/ci-buddy/$run"
        fi
    ) 3>"$root/containers/recover-$project-$run.lock"
}
case $command in
    version)
        python3 "$data" available "$root"
        cat "$root/bin/revision"
        ;;
    has-run)
        [[ ${1:-} =~ ^[0-9]+$ && -d $folder/runs/$1 ]]
        ;;
    has-gate)
        [[ ${1:-} =~ ^[0-9a-f]{40}$ ]] || exit 2
        python3 "$data" gate "$folder" "$1"
        ;;
    init)
        mkdir -p "$folder"/{slots,data,secrets,runs,logs}
        chmod 700 "$folder/secrets"
        [[ -d $folder/git ]] || git init --quiet --bare "$folder/git"
        ;;
    submit)
        run=$1; shift
        [[ $run =~ ^[0-9]+$ ]] || exit 2
        # If submission fails before there is a queued task, no runner can clean the ref.
        trap '[[ -n ${id:-} ]] || git -C "$folder/git" update-ref -d "refs/ci-buddy/$run"' EXIT
        mkdir "$folder/runs/$run"
        exec 9>"$folder/submit.lock"; flock 9
        group=$(python3 "$data" job "$folder" "$run" "$@")
        reused=$(pueue status --json | python3 "$data" reuse "$folder" "$run")
        if [[ -n $reused ]]; then
            read -r state original id <<<"$reused"
            flock -u 9
            echo "reused_from=$original"
            if [[ $state == finished ]]; then python3 "$root/bin/archive.py" "$folder/runs/$run"; python3 "$data" read "$folder/runs/$run/report.txt"; exit "$(field exit)"; fi
            run=$original
            echo "run=$run task=$id"
            pueue follow "$id" || true
            wait_task "$id"; exit "$(field exit)"
        fi
        values=$(python3 "$data" load "$folder/runs/$run" ""); eval "$values"
        id=$(pueue add --stashed --print-task-id --group "$group" --label "$project/$run/$key" --escape -- bash "$root/bin/job.sh" "$root" "$project" "$run")
        write_field task "$id"
        pueue enqueue "$id"
        flock -u 9
        echo "run=$run task=$id"
        pueue follow "$id" || true
        wait_task "$id"
        exit "$(field exit)"
        ;;
    distance|export) python3 "$root/bin/workers.py" "$command" "$root" "$project" "$1" ;;
    history) python3 "$data" history "$folder" "$@" ;;
    verify)
        commit=${1:?commit required}
        run=$(python3 "$data" gate "$folder" "$commit")
        out=$folder/runs/$run
        task=$(field task)
        wait_task "$task"
        bench_id=$(field bench-task)
        if [[ -n $bench_id ]]; then
            bench_exit=$(field bench-exit)
            [[ -n $bench_exit ]] || echo "waiting bench_task=$bench_id"
            wait_task "$bench_id" bench-
        fi
        python3 "$data" read "$out/report.txt"
        values=$(python3 "$data" load "$out" ""); eval "$values"
        [[ $(field exit) == 0 ]] || exit 1
        if [[ $bench_required == True ]]; then
            [[ $(field bench-exit) == 0 ]] || exit 1
        fi
        echo "verified=$commit base=$base"
        ;;
    status)
        pueue status
        git -C "$folder/git" for-each-ref --format='%(refname:short) %(objectname:short)' refs/slots
        ;;
    log|cancel)
        run=${1:?run required}
        [[ $run =~ ^[0-9]+$ ]] || exit 2
        if [[ $command == log ]]; then
            python3 "$data" log "$folder" "$run"
        else
            if [[ -n $(field exit) && ( -z $(field bench-task) || -n $(field bench-exit) ) ]]; then exit 0; fi
            if [[ -f $folder/runs/$run/job.json ]]; then
                worker=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("worker", ""))' "$folder/runs/$run/job.json")
                if [[ -n $worker ]]; then
                    python3 "$root/bin/ssh.py" "${worker%%:*}" "bash $(printf '%q' "${worker#*:}/bin/ci-buddy") --server $(printf '%q ' "$project" cancel "$run")"
                fi
            fi
            stop_container() {
                for container in "ci-buddy-$run" "ci-buddy-prepare-$run" "ci-buddy-fetch-$run"; do
                    if podman container exists "$container"; then podman kill "$container"; return; fi
                done
                return 1
            }
            if stop_container; then exit 0; fi
            tasks=$(pueue status --json | python3 "$data" task "$project/$run")
            read -r task prefix <<<"$tasks"
            [[ -n $task ]] || exit 0
            if pueue remove "$task"; then
                write_field "${prefix}exit" 137
                python3 "$data" stamp "$folder/runs/$run" "${prefix//-/_}exit" 137
                python3 "$data" stamp "$folder/runs/$run" "${prefix//-/_}ended_at" "$EPOCHREALTIME"
                python3 "$data" append "$folder/runs/$run/report.txt" 'cancelled before start; stats incomplete'
                python3 "$data" record "$folder/runs/$run"
                python3 "$root/bin/archive.py" "$folder/runs/$run"
                git -C "$folder/git" update-ref -d "refs/ci-buddy/$run"
            elif [[ -n $task ]]; then
                pueue kill "$task"
                stop_container || true
            fi
        fi
        ;;
    *) echo "unknown server command: $command" >&2; exit 2 ;;
esac
