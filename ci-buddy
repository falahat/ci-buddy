set -euo pipefail
set +x
if [[ ${1:-} == --server ]]; then
    shift
    root=$(cd "$(dirname "$0")/.." && pwd -P)
    expected=${1:?reviewed client revision required}; shift
    [[ $(<"$root/bin/revision") == "$expected" ]] || { echo 'coordinator reviewed version differs; no job submitted' >&2; exit 2; }
    exec python3 "$root/bin/control.py" "$root" "$@"
fi
[[ -n ${BASH_SOURCE[0]:-} ]] || { echo 'use the installed local ci-buddy client' >&2; exit 2; }
client_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ -f $client_dir/revision ]]; then revision=$(<"$client_dir/revision")
else revision=$(git -C "$client_dir" rev-parse --verify HEAD); fi
[[ $revision =~ ^[0-9a-f]{40}$ ]] || exit 2
command=${1:?command required}; shift
case $command in
    auth) exec python3 "$client_dir/auth.py" client "$@" ;;
    run|test|gate|bench|status|history|log|cancel|verify|merge|enroll) ;;
    *) echo 'expected run, test, gate, bench, verify, merge, status, history, log, cancel or enroll' >&2; exit 2 ;;
esac
mapfile -t configured < <(git config --global --get-all ci-buddy.host || true)
((${#configured[@]} == 1)) || { echo 'configure exactly one coordinator with install-client.sh --host <destination>[:<root>]' >&2; exit 2; }
endpoint=${configured[0]}
destination=${endpoint%%:*}; remote_root=.ci-buddy
[[ $endpoint != *:* ]] || remote_root=${endpoint#*:}
[[ $destination =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$ ]] || exit 2
[[ $remote_root == .ci-buddy || $remote_root == /* ]] || exit 2
[[ $remote_root != *$'\n'* && $remote_root != *$'\r'* ]] || exit 2
[[ $destination != local || $remote_root != .ci-buddy ]] || remote_root=$HOME/.ci-buddy
transport=(python3 "$client_dir/ssh.py")
if [[ $command == enroll ]]; then
    machine=${1:?existing machine required}
    shift
    while (($#)); do
        option=$1
        shift
        if [[ $option == --*=* ]]; then
            value=${option#*=}
            option=${option%%=*}
        else
            value=${1:?option value required}
            shift
        fi
        case $option in
            --root) worker_root=$value ;;
            --host-conf) host_conf=$value ;;
            *) echo 'expected --root or --host-conf' >&2; exit 2 ;;
        esac
    done
    : "${worker_root:?worker root required}" "${host_conf:?public host.conf required}"
    arguments=(python3 "$remote_root/bin/enroll.py" "$remote_root" "$machine" "--root=$worker_root" --host-conf -)
    if [[ $destination == local ]]; then "${arguments[@]}" <"$host_conf"
    else "${transport[@]}" "$destination" "$(printf '%q ' "${arguments[@]}")" <"$host_conf"; fi | python3 "$client_dir/safe_output.py"
    exit
fi
cd "$(git rev-parse --show-toplevel)"
while IFS= read -r line; do
    if [[ $line =~ ^(name|main)[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
        printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
    fi
done <ci-buddy.toml
: "${name:?}" "${main:?}"
[[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
git check-ref-format "refs/heads/$main"
invoke() {
    if [[ $destination == local ]]; then bash "$remote_root/bin/ci-buddy" --server "$revision" "$name" "$@"
    else printf '%s\0' bash "$remote_root/bin/ci-buddy" --server "$revision" "$name" "$@" | "${transport[@]}" "$destination" --argv; fi
}
remote() {
    invoke "$@" 2>&1 | python3 "$client_dir/safe_output.py"
    local statuses=("${PIPESTATUS[@]}")
    ((statuses[1] == 0)) || return "${statuses[1]}"
    return "${statuses[0]}"
}
case $command in
    status|history)
        arguments=("$@")
        if [[ $command == history && ${1:-} == change ]]; then
            arguments=(change "$(git rev-parse "${2:?ref required}")" "$(git rev-parse "$2^{tree}")")
        elif [[ $command == history && ${1:-} == failures && ${2:-} == --range ]]; then
            range=${3:?range required}; arguments=(failures --range "$(git rev-parse "${range%..*}")..$(git rev-parse "${range#*..}")")
        fi
        remote "$command" "${arguments[@]}"; exit $? ;;
    log|cancel)
        run=${1:?native job ID required}; [[ $run =~ ^j_[0-9A-HJKMNP-TV-Z]{26}$ ]] || exit 2
        remote "$command" "$run"; exit $? ;;
    verify) remote verify "$(git rev-parse "${1:-HEAD}")"; exit $? ;;
    merge)
        git diff --quiet HEAD -- || { echo 'commit tracked edits before merge' >&2; exit 1; }
        candidate=$(git rev-parse HEAD)
        result=$(remote verify "$candidate") || { printf '%s\n' "$result"; exit 1; }
        printf '%s\n' "$result"
        verified=${result##*$'\n'}
        [[ $verified =~ ^verified=$candidate\ base=([0-9a-f]+)$ ]] || exit 1
        expected=${BASH_REMATCH[1]}
        current=$(git ls-remote origin "refs/heads/$main")
        [[ $current == "$expected"$'\t'* ]] || { echo 'main moved; integrate it and gate again' >&2; exit 1; }
        git push origin "$candidate:refs/heads/$main"; exit $? ;;
esac
if [[ $command == test ]]; then
    arguments=("$@")
    i=0
    [[ ${arguments[0]:-} != --rerun ]] || i=1
    if [[ ${arguments[i]:-} == --since ]]; then
        i=$((i+1))
        arguments[i]=$(git rev-parse "${arguments[i]:?base required}")
        since=${arguments[i]}
    fi
    set -- "${arguments[@]}"
fi
candidate=$(git rev-parse HEAD)
changed=0
git diff --quiet HEAD -- || changed=$?
case $changed in
    0) ;;
    1) candidate=$(git stash create); [[ -n $candidate ]] || exit 1 ;;
    *) exit "$changed" ;;
esac
main_ref=$(git rev-parse --quiet --verify "origin/$main" || git rev-parse --verify "$main")
base=${since:-$(git merge-base "$candidate" "$main_ref")}
branch=$(git symbolic-ref --quiet --short HEAD) || { status=$?; [[ $status == 1 ]] || exit "$status"; branch=""; }
nonce=$((${EPOCHREALTIME/./} * 1000 + RANDOM % 1000))
remote init
target=$remote_root/projects/$name/git
[[ $destination == local ]] || target=$destination:$target
GIT_SSH_COMMAND=$(printf '%q ' "${transport[@]}") GIT_SSH_VARIANT=simple git push --atomic --quiet --no-verify "$target" \
    "$candidate:refs/ci-buddy/$nonce" "$base:refs/ci-buddy/base-$nonce" 2>&1 | python3 "$client_dir/safe_output.py"
# A lost submit reply is ambiguous; inspect native status before submitting again.
if remote submit "$nonce" "$command" "$candidate" "$base" "$branch" "${CI_BUDDY_SUBMITTER:-$HOSTNAME}" "$@"; then exit 0
else status=$?; printf 'submission ended with status %s; inspect status before submitting again\n' "$status" >&2; exit "$status"; fi
