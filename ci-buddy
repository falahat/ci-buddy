set -euo pipefail
if [[ ${1:-} != --server ]]; then
    cd "$(git rev-parse --show-toplevel)"
    while IFS= read -r line; do
        if [[ $line =~ ^(name|host|main)[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
            printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
        fi
    done <ci-buddy.toml
    : "${name:?}" "${host:?}" "${main:?}"
    [[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
    command=${1:?command required}; shift
    remote() { ssh "$host" "bash ~/.ci-buddy/bin/ci-buddy --server $(printf '%q ' "$name" "$@")"; }
    case $command in
        status|log|cancel) remote "$command" "$@"; exit $? ;;
        verify) remote verify "$(git rev-parse "${1:?commit required}")"; exit $? ;;
        merge)
            git diff --quiet HEAD -- || { echo 'commit tracked edits before merge' >&2; exit 1; }
            candidate=$(git rev-parse HEAD)
            result=$(remote verify "$candidate") || { printf '%s\n' "$result"; exit 1; }
            printf '%s\n' "$result"
            verified=${result##*$'\n'}
            [[ $verified =~ ^verified=$candidate\ base=([0-9a-f]+)$ ]] || exit 1
            expected=${BASH_REMATCH[1]}
            current=$(git ls-remote origin "refs/heads/$main")
            [[ $current == "$expected"$'\t'* ]] || { echo 'main moved; integrate it and gate again' >&2; exit 1; }
            git push origin "$candidate:refs/heads/$main"
            exit $? ;;
        run|test|gate) ;;
        *) echo "expected run, test, gate, verify, merge, status, log or cancel" >&2; exit 2 ;;
    esac
    candidate=$(git rev-parse HEAD)
    changed=0
    git diff --quiet HEAD -- || changed=$?
    case $changed in
        0) ;;
        1) candidate=$(git stash create); [[ -n $candidate ]] || exit 1 ;;
        *) exit "$changed" ;;
    esac
    main_ref=$(git rev-parse --quiet --verify "origin/$main" || git rev-parse --verify "$main")
    base=$(git merge-base "$candidate" "$main_ref")
    branch=$(git symbolic-ref --short HEAD)
    run=$((${EPOCHREALTIME/./} * 1000 + RANDOM % 1000))
    remote init
    git push --quiet --no-verify "$host:.ci-buddy/projects/$name/git" "$candidate:refs/ci-buddy/$run"
    remote submit "$run" "$command" "$candidate" "$base" "$branch" "${CI_BUDDY_SUBMITTER:-$HOSTNAME}" "$@"
    exit $?
fi
shift
project=${1:?project required}; command=${2:?command required}; shift 2
[[ $project =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
root=$(cd "$(dirname "$0")/.." && pwd -P)
export PATH="$root/bin:$PATH"
export PUEUE_CONFIG_PATH="$root/pueue.yml"
data=$root/bin/data.py
folder=$root/projects/$project
wait_task() {
    local id=$1 prefix=${2:-}
    [[ ! -f $folder/runs/$run/${prefix}exit ]] || return 0
    pueue wait --quiet "$id" || true
    if [[ ! -f $folder/runs/$run/${prefix}exit ]]; then
        podman wait "ci-buddy-$run" || podman wait "ci-buddy-fetch-$run" || true
        python3 "$data" report "$folder/runs/$run" "$prefix"
        echo 137 >"$folder/runs/$run/${prefix}exit"
    fi
}
case $command in
    init)
        mkdir -p "$folder"/{slots,data,secrets,runs,logs}
        chmod 700 "$folder/secrets"
        [[ -d $folder/git ]] || git init --quiet --bare "$folder/git"
        ;;
    submit)
        run=$1; shift
        [[ $run =~ ^[0-9]+$ ]] || exit 2
        mkdir "$folder/runs/$run"
        group=$(python3 "$data" job "$folder" "$run" "$@")
        id=$(pueue add --stashed --print-task-id --group "$group" --label "$project/$run" --escape -- bash "$root/bin/job.sh" "$root" "$project" "$run")
        echo "$id" >"$folder/runs/$run/task"
        pueue enqueue "$id"
        echo "run=$run task=$id"
        pueue follow "$id" || true
        wait_task "$id"
        exit "$(<"$folder/runs/$run/exit")"
        ;;
    verify)
        commit=${1:?commit required}
        run=$(python3 "$data" gate "$folder" "$commit")
        out=$folder/runs/$run
        wait_task "$(<"$out/task")"
        if [[ -f $out/bench-task ]]; then
            [[ -f $out/bench-exit ]] || echo "waiting bench_task=$(<"$out/bench-task")"
            wait_task "$(<"$out/bench-task")" bench-
        fi
        cat "$out/report.txt"
        values=$(python3 "$data" load "$out" ""); eval "$values"
        [[ $(<"$out/exit") == 0 ]] || exit 1
        if [[ $bench_required == True ]]; then
            [[ -f $out/bench-exit && $(<"$out/bench-exit") == 0 ]] || exit 1
        fi
        echo "verified=$commit base=$base"
        ;;
    status)
        pueue status
        git -C "$folder/git" for-each-ref --format='%(refname:short) %(objectname:short)' refs/slots
        ;;
    log|cancel)
        run=${1:?run required}
        [[ $run =~ ^[0-9]+$ ]] || exit 2
        if [[ $command == log ]]; then
            ids=("$(<"$folder/runs/$run/task")")
            [[ ! -f $folder/runs/$run/bench-task ]] || ids+=("$(<"$folder/runs/$run/bench-task")")
            pueue log "${ids[@]}"
        else
            prefix=""; [[ ! -f $folder/runs/$run/bench-task ]] || prefix=bench-
            [[ ! -f $folder/runs/$run/${prefix}exit ]] || exit 0
            label="$project/$run"; [[ -z $prefix ]] || label="$label/bench"
            task=$(pueue status --json | python3 "$data" task "$label")
            stop_container() {
                for container in "ci-buddy-$run" "ci-buddy-fetch-$run"; do
                    if podman container exists "$container"; then podman kill "$container"; return; fi
                done
                return 1
            }
            if stop_container; then
                :
            elif [[ -n $task ]] && pueue remove "$task"; then
                echo 137 >"$folder/runs/$run/${prefix}exit"
                echo 'cancelled before start; stats incomplete' >>"$folder/runs/$run/report.txt"
            elif [[ -n $task ]]; then
                pueue kill "$task"
                stop_container || true
            fi
        fi
        ;;
    *) echo "unknown server command: $command" >&2; exit 2 ;;
esac
