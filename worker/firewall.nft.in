# Dedicated worker only. The owner verifies the rendered policy before admission.
destroy table inet ci_buddy_worker
table inet ci_buddy_worker {
    set approved4 { type ipv4_addr; elements = { @APPROVED4@ } }
    set approved6 { type ipv6_addr; elements = { @APPROVED6@ } }
    set dns4 { type ipv4_addr; elements = { @DNS4@ } }
    set dns6 { type ipv6_addr; elements = { @DNS6@ } }
    set private4 {
        type ipv4_addr; flags interval;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
            224.0.0.0/4, 240.0.0.0/4 }
    }
    set private6 {
        type ipv6_addr; flags interval;
        elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96,
            64:ff9b:1::/48, 100::/64, 2001::/32, 2001:db8::/32,
            2002::/16, fc00::/7, fe80::/10, ff00::/8 }
    }
    chain runner_output {
        ip daddr @dns4 meta l4proto { tcp, udp } th dport 53 accept
        ip6 daddr @dns6 meta l4proto { tcp, udp } th dport 53 accept
        ip daddr @private4 reject
        ip6 daddr @private6 reject
        tcp dport { 22, 80, 443 } accept
        reject
    }
    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        iifname "lo" accept
        ip saddr @approved4 tcp dport 22 accept
        ip6 saddr @approved6 tcp dport 22 accept
        @IAP_RULE@
        udp dport 41641 accept
        udp sport 67 udp dport 68 accept
        udp sport 547 udp dport 546 accept
        icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    }
    chain output {
        type filter hook output priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        meta skuid @RUNNER_UID@ jump runner_output
        oifname "lo" accept
        ip daddr @dns4 meta l4proto { tcp, udp } th dport 53 accept
        ip6 daddr @dns6 meta l4proto { tcp, udp } th dport 53 accept
        # Only native OS daemons reach provider metadata; runner traffic branched above.
        meta skuid 0 ip daddr 169.254.169.254 tcp dport 80 accept
        ip daddr 169.254.169.254 udp dport 123 accept
        udp sport 68 udp dport 67 accept
        udp sport 546 udp dport 547 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        # tailscaled runs as root; these are encrypted mesh transport, not job ports.
        meta skuid 0 udp sport 41641 accept
        ip daddr @private4 reject
        ip6 daddr @private6 reject
        tcp dport { 80, 443 } accept
        meta skuid 0 udp dport 3478 accept
        udp dport 123 accept
    }
    chain forward { type filter hook forward priority filter; policy drop; }
}
